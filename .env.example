# Konfigurasi UIP-Command (Salin fail ini menjadi .env sebelum dijalankan)

# Google Gemini API Key (untuk gemini-decision-1, gemini-4-hydrogen, gemini-4-argon)
GEMINI_API_KEY=your_gemini_api_key_here

# Enjin Privasi & Laras Bahasa Tempatan (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:12b
OLLAMA_TIMEOUT_SECONDS=12.0

# Pemetaan Model Gemini Mengikut Tugas (Interactions & Decisions API)
DECISION_MODEL=gemini-decision-1
MULTIMODAL_MODEL=gemini-4-hydrogen
REASONING_MODEL=gemini-4-argon
REASONING_MODEL_ALIAS=gemini-4-argon

# Pangkalan Data RAG Statutori (ChromaDB) & Storan Utama (SQLite tempatan / PostgreSQL Cloud Run)
CHROMA_PERSIST_DIR=./data/chroma_db
AKTA_DIR=./data/akta
DATABASE_URL=

# Arkib & Private Bucket Pembangun Eksklusif (zero4eleven@gmail.com sahaja)
# Boleh guna Neon Object Storage (AWS_* diisi automatik oleh `neon deploy` / `neon env pull`)
# atau sebarang bucket S3-compatible persendirian.
DEV_ARCHIVE_BUCKET=dev-vault
DEV_ARCHIVE_PREFIX=dev-vault
DEV_ARCHIVE_LOCAL_DIR=./data/dev_vault
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1

# Google OAuth 2.0 Web Client ID (Google Sign-In Produksi)
GOOGLE_CLIENT_ID=

# Pelayan API & Frontend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
